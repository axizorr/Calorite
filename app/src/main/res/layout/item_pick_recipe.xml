<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardPickRecipe"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- Nama Resep -->
        <TextView
            android:id="@+id/tvPickRecipeName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nasi Goreng Telur Orak Arik"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Kalori -->
        <TextView
            android:id="@+id/tvPickRecipeCalories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="400 kcal"
            android:textSize="12sp"
            android:textColor="#000000"
            android:layout_marginEnd="4dp" />

        <!-- Protein -->
        <TextView
            android:id="@+id/tvPickRecipeProtein"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="17 gr"
            android:textSize="12sp"
            android:textColor="#000000"
            android:layout_marginEnd="4dp" />

        <!-- Check Icon (Dihidupkan saat terpilih) -->
        <ImageView
            android:id="@+id/ivPickRecipeCheck"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/checkbox_on_background"
            android:visibility="gone"
            app:tint="#000000" />

    </LinearLayout>
</androidx.cardview.widget.CardView>