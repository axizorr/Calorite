<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#EFEFEF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <androidx.cardview.widget.CardView
            android:layout_width="100dp"
            android:layout_height="80dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#D9D9D9">

            <!-- KITA GANTI JADI FRAMELAYOUT BERLAPIS -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivHistoryListThumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/mealtrackbw"
                    android:scaleType="centerCrop"/>

                <ImageView
                    android:id="@+id/ivListProgressCalorie"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/ivListProgressProtein"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
            </FrameLayout>

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/tvHistoryListProtein"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🥩 90g Protein"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:fontFamily="@font/afacad"/>

            <TextView
                android:id="@+id/tvHistoryListCal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 1480 kcal"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/afacad"/>

            <TextView
                android:id="@+id/tvHistoryListDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="26 September 2026 >"
                android:textSize="13sp"
                android:textColor="#555555"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/afacad"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>