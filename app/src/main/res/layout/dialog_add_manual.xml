<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Label Image -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Image (Optional)"
        android:textColor="#000000"
        android:textStyle="bold"
        android:fontFamily="@font/afacad"/>

    <!-- Tombol Choose File -->
    <Button
        android:id="@+id/btnChooseFile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#E0E0E0"
        android:text="Choose File"
        android:textColor="#000000"
        android:fontFamily="@font/afacad"/>

    <!-- Label Calories & Protein -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Calories &amp; Protein"
        android:textColor="#000000"
        android:textStyle="bold"
        android:fontFamily="@font/afacad"/>

    <!-- Input Kcal & Gram berdampingan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etManualCal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="kcal"
            android:inputType="number"
            android:fontFamily="@font/afacad"/>

        <EditText
            android:id="@+id/etManualPro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:hint="gr"
            android:inputType="number"
            android:fontFamily="@font/afacad"/>
    </LinearLayout>

    <!-- Tombol Save dengan Kodemu -->
    <Button
        android:id="@+id/btnSaveManual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="#FED563"
        android:text="Simpan Data"
        android:fontFamily="@font/afacad"
        android:textColor="#000000"
        android:textStyle="bold" />
    <Button
        android:id="@+id/btnTambahDariRecipe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:backgroundTint="#DAFE63"
        android:fontFamily="@font/afacad"
        android:text="Tambah dari Recipe"
        android:textColor="#000000"
        android:textStyle="bold" />

</LinearLayout>